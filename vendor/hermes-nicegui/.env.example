HERMES_GATEWAY_URL=http://127.0.0.1:8443
HERMES_API_TOKEN=
HERMES_KANBAN_URL=http://127.0.0.1:9119
HERMES_KANBAN_USERNAME=
HERMES_KANBAN_PASSWORD=
HERMES_UI_HOST=0.0.0.0
HERMES_UI_PORT=8080
HERMES_UI_DARK=false
HERMES_UI_RELOAD=false
HERMES_DEFAULT_MODEL=hermes-agent
HERMES_DEFAULT_PROVIDER=
# How sessions/cron/chat reach the `hermes` CLI: "local" runs it as a
# subprocess on this host; "ssh" runs it over `ssh -tt <ssh_target>` instead
# (works for both one-shot commands and the interactive chat pty).
HERMES_EXEC_MODE=local
HERMES_CLI_BIN=hermes
HERMES_SSH_TARGET=
HERMES_SSH_OPTIONS=
# Local username/password auth (see README) -- first visit to the app shows
# a "create admin account" form. HERMES_AUTH_ENABLED=false is an escape
# hatch for an already-firewalled deployment that wants to skip login.
HERMES_AUTH_ENABLED=true
HERMES_DATA_DIR=~/.local/share/hermes-nicegui
HERMES_PLUGINS_DISABLED=
# Read-only xaelwiki notes browser: where the notes vault lives (markdown
# files with YAML frontmatter) and how often the list re-scans it. Defaults
# match the deploy box, where the hermes user is in the xaelwiki group.
HERMES_XAELWIKI_NOTES_DIR=/var/lib/xaelwiki/notes
HERMES_XAELWIKI_REFRESH_SECONDS=30
# Chat file attachments are saved under this local directory (the agent runs
# on the same box, so a local path is one the agent can read). Empty uses
# <HERMES_HOME>/uploads. Per-file cap in bytes (default 25 MiB).
HERMES_CHAT_UPLOADS_DIR=
HERMES_CHAT_UPLOAD_MAX_BYTES=26214400
# VNC viewer plugin: noVNC's install root (<store>/share/webapps/novnc) and
# the companion systemd service's x11vnc endpoint + password/state files.
# Empty HERMES_VNC_NOVNC_DIR renders the page with a "client assets missing"
# notice instead of a live canvas.
HERMES_VNC_NOVNC_DIR=
HERMES_VNC_STATE_DIR=/var/lib/hermes-vnc
HERMES_VNC_PASSWORD_FILE=/run/hermes-vnc/passwd
HERMES_VNC_HOST=127.0.0.1
HERMES_VNC_PORT=5901
