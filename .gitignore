# Result artifacts from nix builds
result
result-*

# NixOS generation / boot artifacts
*.qcow2
*.raw
*.img

# Local vendor checkouts (no longer git submodules — plain source trees for editing)
vendor/

# Local secret decryption intermediates
secrets/*.tmp

# Private key uploaded to the LXC at creation time — never commit.
secrets/lxc-host-ed25519

# Deploy logs
/var/log/hermes-deploy.log

# Editor
.vscode/
.idea/
*.swp

# Python bytecode from local smoke runs
__pycache__/
*.pyc

# LXC host private key — never commit (gitignored in secrets/ too).
lxc-host-ed25519
