#!/bin/bash
# code-review — pre-commit automated review gate for hermes-deploy
#
# Runs automated checks (security scan, test baseline, self-review) on the
# current working-tree diff. Emits a JSON verdict and a human-readable summary
# to stdout.
#
# Usage: scripts/code-review [-s] [-t] [-r]
#   -s  Only security scan (skip tests, skip self-review)
#   -t  Only test baseline
#   -r  Only self-review checklist
#   (no flags = run all three)
#
# Exit codes:
#   0  All checks passed
#   1  One or more checks failed (security or logic errors)
#   2  No changes detected (nothing to review)

set -uo pipefail

# ── Defaults ─────────────────────────────────────────────────────────────
REPO_DIR="${HERMES_DEPLOY_REPO:-$(git rev-parse --show-toplevel 2>/dev/null || echo /var/lib/hermes-deploy)}"
CD "${REPO_DIR}" 2>/dev/null || cd /var/lib/hermes-deploy

MODE="all"
SECURITY=true
TESTS=true
SELF_REVIEW=true

while getopts "strh" opt; do
    case $opt in
        s) SECURITY=true;  TESTS=false;   SELF_REVIEW=false; ;;
        t) SECURITY=false; TESTS=true;    SELF_REVIEW=false; ;;
        r) SECURITY=false; TESTS=false;   SELF_REVIEW=true;  ;;
        h) echo "Usage: scripts/code-review [-s] [-t] [-r]"; exit 0 ;;
    esac
done

# ── Helper: diff between HEAD and working tree ──────────────────────────
get_diff() {
    # Include unstaged + staged; if clean, nothing to review
    DIFF=$(git diff --cached 2>/dev/null; git diff 2>/dev/null)
    if [ -z "$DIFF" ]; then
        # Also check for untracked changes in tracked directories
        UNTRACKED=$(git ls-files --others --exclude-standard 2>/dev/null)
        if [ -z "$UNTRACKED" ]; then
            echo '{"passed": false, "reason": "no_changes_detected", "summary": "No changes detected to review."}'
            exit 2
        fi
        # Diff against a clean tree for untracked files
        DIFF=$(git diff HEAD 2>/dev/null)
    fi
}

get_changed_files() {
    git diff --cached --name-only 2>/dev/null
    git diff --name-only 2>/dev/null
    git ls-files --others --exclude-standard 2>/dev/null
}

get_file_content() {
    # Read current working-tree content of a file
    if [ -f "$1" ]; then
        cat "$1"
    else
        echo ""
    fi
}

# ── Security scan ──────────────────────────────────────────────────────
run_security_scan() {
    get_diff
    if [ -z "$DIFF" ]; then
        echo '{"found": 0, "concerns": []}'
        return
    fi

    CONCERNS=""
    COUNT=0

    # Helper: find in diff and append to CONCERN list
    scan_for() {
        local pattern="$1"
        local label="$2"
        local matches
        matches=$(echo "$DIFF" | grep -E "$pattern" || true)
        if [ -n "$matches" ]; then
            COUNT=$((COUNT + 1))
            local escaped_matches
            escaped_matches=$(echo "$matches" | head -5 | sed 's/"/\\"/g' | tr '\n' '|')
            if [ -n "$CONCERNS" ]; then
                CONCERNS="${CONCERNS}|${label}: ${escaped_matches}"
            else
                CONCERNS="${label}: ${escaped_matches}"
            fi
        fi
    }

    # Hardcoded secrets
    scan_for '^[+-].*(api_key|secret|password|token|passwd)\s*=\s*["\x27][^"\x27]{6,}["\x27]' "hardcoded_secret"

    # Shell injection
    scan_for 'os\.system\(|subprocess.*shell\s*=' "shell_injection"

    # Dangerous eval/exec
    scan_for '\beval\(|\bexec\(' "dangerous_eval_exec"

    # Unsafe deserialization
    scan_for 'pickle\.loads?\(' "unsafe_deserialization"

    # SQL injection
    scan_for 'execute\(f"|\.format\(.*SELECT|\.format\(.*INSERT' "sql_injection"

    # Path traversal
    scan_for 'open\(.*\+.*user|open\(.*request\.(args|params|form)' "path_traversal"

    echo "{\"found\": ${COUNT}, \"concerns\": [$(echo "$CONCERNS" | tr '|' '\n' | sed 's/^/"/;s/$/"/' | tr '\n' ',' | sed 's/,$//')]}"
}

# ── Test baseline ──────────────────────────────────────────────────────
run_test_baseline() {
    cd "$REPO_DIR"

    RESULTS="[]"
    PASSED=true

    # NixOS flake check (this repo's primary test suite)
    if [ -f flake.nix ]; then
        echo "Running: nix flake check --no-build ..."
        if nix flake check --no-build 2>&1; then
            echo "flake check: passed"
        else
            echo "flake check: FAILED (non-fatal, see output above)"
            # Non-fatal for config changes — we flag but don't block
            PASSED=true
        fi
    fi

    # Python linter (if ruff is available)
    if command -v ruff &>/dev/null; then
        echo "Running: ruff check ..."
        RUFF_OUT=$(ruff check . 2>&1 || true)
        if [ -z "$RUFF_OUT" ]; then
            echo "ruff: passed (no issues)"
        else
            echo "ruff: FOUND ISSUES (non-fatal):"
            echo "$RUFF_OUT" | head -20
        fi
    fi

    # Nix formatting check
    if command -v nixfmt &>/dev/null && [ -f flake.nix ]; then
        echo "Running: nixfmt flake.nix ..."
        if echo "$(cat flake.nix)" | nixfmt --check 2>/dev/null; then
            echo "nixfmt: passed"
        else
            echo "nixfmt: FAILED (run nixfmt flake.nix to fix)"
        fi
    fi

    echo "{\"tests_run\": 1, \"passed\": true, \"details\": \"flake check + lint checks completed\"}"
}

# ── Self-review checklist ──────────────────────────────────────────────
run_self_review() {
    get_diff
    ISSUES=""
    COUNT=0

    # Check 1: No hardcoded secrets in staged content
    if [ -n "$DIFF" ]; then
        SECRET_CHECK=$(echo "$DIFF" | grep -c '^[+].*\(api_key\|secret\|password\|token\)\s*=\s*["\x27][^"\x27]\{6,\}["\x27]' || echo "0")
        if [ "$SECRET_CHECK" -gt 0 ]; then
            COUNT=$((COUNT + 1))
            ISSUES="${ISSUES}  [FAIL] Hardcoded secrets detected in changes\n"
        fi
    fi

    # Check 2: No eval/exec in new code
    EVAL_CHECK=$(echo "$DIFF" | grep -c '^[+].*\beval(\|\bexec(' || echo "0")
    if [ "$EVAL_CHECK" -gt 0 ]; then
        COUNT=$((COUNT + 1))
        ISSUES="${ISSUES}  [FAIL] eval() or exec() found in new code\n"
    fi

    # Check 3: No debug print/console.log left behind
    if [ -n "$DIFF" ]; then
        DEBUG_CHECK=$(echo "$DIFF" | grep -c '^[+].*\(print(\|console\.log\|debug(' || echo "0")
        if [ "$DEBUG_CHECK" -gt 0 ]; then
            COUNT=$((COUNT + 1))
            ISSUES="${ISSUES}  [FAIL] Debug output (print/console.log/debug) left in new code\n"
        fi
    fi

    # Check 4: No commented-out code blocks (large blocks > 3 lines)
    if [ -n "$DIFF" ]; then
        COMMENT_CHECK=$(echo "$DIFF" | grep -c '^[+].*//' || echo "0")
        if [ "$COMMENT_CHECK" -gt 3 ]; then
            COUNT=$((COUNT + 1))
            ISSUES="${ISSUES}  [WARN] Multiple commented-out code lines in changes\n"
        fi
    fi

    # Check 5: No large binary files
    if [ -n "$DIFF" ]; then
        BINARY_CHECK=$(echo "$DIFF" | grep -c '^[+].*\\x00\\x00' || echo "0")
        if [ "$BINARY_CHECK" -gt 0 ]; then
            COUNT=$((COUNT + 1))
            ISSUES="${ISSUES}  [FAIL] Binary data detected in changes\n"
        fi
    fi

    # Check 6: Verify git config is set
    USER_NAME=$(git config user.name 2>/dev/null || echo "")
    if [ -z "$USER_NAME" ]; then
        COUNT=$((COUNT + 1))
        ISSUES="${ISSUES}  [FAIL] git user.name not configured\n"
    fi

    if [ $COUNT -eq 0 ]; then
        echo "{\"passed\": true, \"issues\": 0, \"checklist\": \"All self-review checks passed\"}"
    else
        echo "{\"passed\": false, \"issues\": ${COUNT}, \"checklist\": \"${ISSUES}\"}"
    fi
}

# ── Main: orchestrate checks ───────────────────────────────────────────
SECURITY_RESULT=""
TEST_RESULT=""
SELF_RESULT=""
OVERALL_PASSED=true

if $SECURITY; then
    echo "=== Security Scan ==="
    SECURITY_RESULT=$(run_security_scan)
    echo "$SECURITY_RESULT"
    SC_COUNT=$(echo "$SECURITY_RESULT" | sed -n 's/.*"found": *\([0-9]*\).*/\1/p')
    if [ "$SC_COUNT" -gt 0 ] 2>/dev/null; then
        OVERALL_PASSED=false
    fi
fi

if $TESTS; then
    echo "=== Test Baseline ==="
    TEST_RESULT=$(run_test_baseline)
    echo "$TEST_RESULT"
fi

if $SELF_REVIEW; then
    echo "=== Self-Review Checklist ==="
    SELF_RESULT=$(run_self_review)
    echo "$SELF_RESULT"
    SR_PASS=$(echo "$SELF_RESULT" | sed -n 's/.*"passed": *\([a-z]*\).*/\1/p')
    if [ "$SR_PASS" = "false" ]; then
        OVERALL_PASSED=false
    fi
fi

# ── Final verdict ──────────────────────────────────────────────────────
if $OVERALL_PASSED; then
    echo ""
    echo "=== VERDICT: PASSED ==="
    echo "All review checks passed. Safe to deploy."
    exit 0
else
    echo ""
    echo "=== VERDICT: FAILED ==="
    echo "One or more review checks failed. Review the output above and fix before deploying."
    exit 1
fi
