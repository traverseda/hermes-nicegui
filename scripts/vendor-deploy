#!/usr/bin/env bash
# vendor-deploy — Atomically push a vendored-source change to its GitHub
# fork, update flake.lock, and optionally deploy.  Wraps the workflow so
# the operator never forgets the `nix flake lock` step (the #1 source of
# deploy failures).
#
# Usage:
#   vendor-deploy <package-name> "<commit-message>" [deploy]
#
# Steps performed:
#   1. git clone the fork's repo into a temp dir
#   2. git add -A && commit inside the fork clone
#   3. git push the fork clone (push access must be configured)
#   4. nix flake lock --update-input  <input-name>   ← the critical step
#   5. git add flake.lock && commit in outer repo
#   6. (optional) nix flake check --no-build  to validate
#   7. (optional) hermes-deploy  (triggers the systemd oneshot unit)
#
# Environment:
#   VENDOR_DEPLOY_DIR  path to the flake repo (default: /var/lib/hermes-deploy)
#   VENDOR_DEPLOY_FLAKE_ATTR  flake attribute to deploy (default: hermes)

set -euo pipefail

REPO_DIR="${VENDOR_DEPLOY_DIR:-$(pwd)}"

usage() {
  cat <<EOF
Usage: vendor-deploy <package-name> "<commit-msg>" [--deploy] [--dry-run]

Package names and their flake input names:
  hermes-agent        → input name: hermes-agent
  hermes-nicegui      → input name: hermes-nicegui-src
  xaelWiki            → input name: xaelwiki-src

Dry-run: validate (flake check --no-build) without deploying.
Deploy: trigger hermes-deploy.service after commit.
EOF
  exit 1
}

[[ $# -lt 2 ]] || [[ "$1" = "--help" ]] && usage

PACKAGE="$1"
shift
MSG="$1"
shift

# Map package path fragment → flake input name
declare -A INPUT_NAME_MAP=(
  [hermes-agent]=hermes-agent
  [hermes-nicegui]=hermes-nicegui-src
  [xaelWiki]=xaelwiki-src
)

if [[ -z "${INPUT_NAME_MAP[$PACKAGE]+x}" ]]; then
  echo "ERROR: unknown package '$PACKAGE'. Use one of: ${!INPUT_NAME_MAP[*]}" >&2
  exit 1
fi

INPUT_NAME="${INPUT_NAME_MAP[$PACKAGE]}"

# --- helpers
log() { echo "[vendor-deploy] $*"; }
die() { echo "[vendor-deploy] ERROR: $*" >&2; exit 1; }

# --- Step 1: Clone the fork repo and commit
log "Step 1/5: Preparing fork clone for $PACKAGE"
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

# Determine which fork repo to use based on the package name
GITHUB_REPO="$PACKAGE"
# For xaelWiki, the GitHub repo is named xaelWiki (capital W)
[[ "$PACKAGE" = "xaelWiki" ]] && GITHUB_REPO="xaelWiki"

if [[ ! -d "$TMP/$GITHUB_REPO" ]]; then
  git clone --depth=1 "git@github.com:traverseda/$GITHUB_REPO.git" "$TMP/$GITHUB_REPO" || \
    die "Failed to clone https://github.com/traverseda/$GITHUB_REPO — is the fork public?"
fi

# Copy the current source tree into the fork
cp -a "$REPO_DIR/vendor/$PACKAGE/." "$TMP/$GITHUB_REPO/" 2>/dev/null || \
  die "No source found at $REPO_DIR/vendor/$PACKAGE — clone the fork to get started"

cd "$TMP/$GITHUB_REPO"
git config user.name "hermes-deploy"
git config user.email "hermes-deploy@localhost"
git add -A
if git diff --cached --quiet 2>/dev/null; then
  log "  No changes in '$PACKAGE' to commit"
else
  git commit -q -m "$MSG"
fi

# --- Step 2: Push the fork
log "Step 2/5: Pushing fork ($GITHUB_REPO)"
if ! git push -q origin main 2>&1; then
  die "git push to traverseda/$GITHUB_REPO failed — check your SSH keys"
fi

# --- Step 3: Update flake.lock with the new commit hash
log "Step 3/5: Updating flake.lock ($INPUT_NAME)"
cd "$REPO_DIR"
if ! nix flake lock --update-input "$INPUT_NAME" 2>&1; then
  die "nix flake lock --update-input $INPUT_NAME failed"
fi

# --- Step 4: Commit the outer repo (flake.lock)
log "Step 4/5: Committing outer repo (updated flake.lock)"
git add flake.lock
if ! git diff --cached --quiet 2>/dev/null; then
  git commit -q -m "$PACKAGE: $MSG" || die "outer repo commit failed"
else
  log "  flake.lock unchanged — no commit"
fi

# --- Step 5: Validate and optionally deploy
log "Step 5/5: Validating with nix flake check --no-build"
DRY_RUN=false
DEPLOY=false

for arg in "$@"; do
  case "$arg" in
    --dry-run)  DRY_RUN=true ; break ;;
    --deploy)   DEPLOY=true ;;
  esac
done

if nix -C "$REPO_DIR" flake check --no-build 2>&1; then
  log "  validation passed"
else
  if $DEPLOY; then
    die "flake check failed — not deploying. Fix the error and try again."
  else
    log "  WARNING: flake check failed (continuing without --deploy)"
  fi
fi

if $DRY_RUN; then
  log "Dry run complete. No deploy performed."
elif $DEPLOY; then
  log "Deploying with hermes-deploy (systemd unit)"
  if command -v hermes-deploy >/dev/null 2>&1; then
    hermes-deploy
  elif command -v nixos-rebuild >/dev/null 2>&1; then
    log "  hermes-deploy not found; falling back to nixos-rebuild --flake"
    nixos-rebuild switch --flake "$REPO_DIR#$VENDOR_DEPLOY_FLAKE_ATTR" --max-jobs 1 --cores 2 2>&1 \
      | tee -a /var/log/hermes-deploy.log
  else
    die "neither hermes-deploy nor nixos-rebuild found on PATH"
  fi
  log "Deploy initiated. Check health with 'hermes-status'."
else
  log "Done. To deploy, run the same command with --deploy or run 'hermes-deploy'."
fi
