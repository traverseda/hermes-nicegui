#!/usr/bin/env bash
# hermes-secrets — per-secret editing, validation, and deploy gate for the
# hermes-deploy secrets store.
#
# Layout (all under the flake repo, default $REPO/secrets/):
#   manifest            plaintext registry: name<TAB>consumers<TAB>required<TAB>placeholder<TAB>purpose
#   <NAME>.age          one encrypted file per secret (recipients: operator + LXC host)
#   operator-pubkey.pub / lxc-host-ed25519.pub     the two recipients
#
# The values live ONLY inside the .age files. This tool reads/writes them with
# `age`, and validates against the manifest so a dropped/rotated-over-secret
# fails loudly instead of silently breaking a service.
#
# Commands:
#   hermes-secrets check            validate every secret; exit 1 on a required
#                                   failure (missing, unreadable, empty, or a
#                                   configured placeholder value). Used by the
#                                   deploy gate — run with --repo on the LXC.
#   hermes-secrets doctor           like check but prints a per-secret status table.
#   hermes-secrets edit <NAME>      decrypt to $EDITOR, re-encrypt to both
#                                   recipients, re-validate. Shows affected
#                                   consumers.
#   hermes-secrets list             print name<TAB>consumers<TAB>status.
#
# Identity resolution for decryption:
#   --identity KEY > $HERMES_SECRETS_IDENTITY > /etc/ssh/ssh_host_ed25519_key
#   (LXC host key — what agenix uses) > ~/.ssh/id_ed25519 (operator).
#   On the LXC the host key is the right identity; on the build machine the
#   operator key is. The editor re-encrypts to the two .pub files in the repo.

set -euo pipefail

# ── Paths ─────────────────────────────────────────────────────────────
REPO="${HERMES_SECRETS_REPO:-}"
if [ -z "$REPO" ]; then
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) REPO=$2; shift 2 ;;
      *) break ;;
    esac
  done
fi
if [ -z "$REPO" ]; then
  REPO=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")
fi
SEC="$REPO/secrets"
MANIFEST="$SEC/manifest"
OP_PUB="$SEC/operator-pubkey.pub"
LX_PUB="$SEC/lxc-host-ed25519.pub"

die() { echo "[hermes-secrets] ERROR: $*" >&2; exit 1; }
say() { echo "[hermes-secrets] $*"; }

[ -f "$MANIFEST" ] || die "no manifest at $MANIFEST (run --repo <flake-repo>?)"

# ── identity ──────────────────────────────────────────────────────────
IDENTITY="${HERMES_SECRETS_IDENTITY:-}"
resolve_identity() {
  local i
  # Explicit > env > LXC agenix host key (only when /run/agenix exists —
  # that dir is the agenix runtime, so we're on the target LXC) > operator key.
  for i in "$IDENTITY" \
    "$( [ -d /run/agenix ] && echo /etc/ssh/ssh_host_ed25519_key )" \
    "$HOME/.ssh/id_ed25519"; do
    [ -n "$i" ] && [ -f "$i" ] && { echo "$i"; return 0; }
  done
  return 1
}
IDENTITY=$(resolve_identity) || die "no usable identity key (pass --identity)"


# ── manifest → per-secret facts ────────────────────────────────────────
# Read manifest lines: name<TAB>consumers<TAB>required<TAB>placeholder<TAB>purpose
# Comments (#) and blank lines ignored.
secret_defs() {
  awk -F '\t' '/^[^#]/ && NF>=3 { gsub(/[ \t]+$/, "", $1); if ($1!="") print }' "$MANIFEST"
}

# status <name> <required> <placeholder>  →  ok|missing|unreadable|empty|placeholder
status_of() {
  local name=$1 required=$2 placeholder=$3 file="$SEC/$1.age"
  [ -f "$file" ] || { echo "missing"; return 0; }
  local val tmp
  tmp=$(mktemp)
  if ! age -d -i "$IDENTITY" "$file" > "$tmp" 2>/dev/null; then
    rm -f "$tmp"; echo "unreadable"; return 0
  fi
  val=$(cat "$tmp")
  rm -f "$tmp"
  [ -n "$val" ] || { echo "empty"; return 0; }
  if [ -n "$placeholder" ] && [ "$val" = "$placeholder" ]; then
    echo "placeholder"; return 0
  fi
  echo "ok"
}

# Alias constraints — values that must be equal (from secrets/README.md).
alias_pairs() {
  cat <<'EOF'
HINDSIGHT_API_KEY=HINDSIGHT_API_TENANT_API_KEY
HINDSIGHT_CP_DATAPLANE_API_KEY=HINDSIGHT_API_TENANT_API_KEY
HINDSIGHT_API_TOKEN=HINDSIGHT_API_TENANT_API_KEY
HINDSIGHT_API_LLM_API_KEY=LLM_API_KEY
OPENCODE_API_KEY=LLM_API_KEY
HERMES_API_TOKEN=API_SERVER_KEY
EOF
}

value_of() {
  local name=$1 file="$SEC/$1.age"
  age -d -i "$IDENTITY" "$file" 2>/dev/null | tr -d '\n'
}

# ── check ─────────────────────────────────────────────────────────────
cmd_check() {
  local failures=0 warnings=0
  while IFS=$'\t' read -r name consumers required placeholder purpose; do
    [ -n "$name" ] || continue
    local st
    st=$(status_of "$name" "$required" "$placeholder")
    case "$st" in
      ok) : ;;
      placeholder)
        # Known-bad value (operator TODO) — loud warning, but not a hard gate
        # failure: a placeholder is a deliberate rotation backlog, whereas a
        # missing/unreadable/empty secret is an accidental drop. The gate must
        # only refuse to deploy when a secret went AWAY.
        echo "WARN  $name  (placeholder '$placeholder')$([ -n "$purpose" ] && printf ' — %s' "$purpose")"
        warnings=$((warnings+1))
        ;;
      *)
        if [ "$required" = "1" ]; then
          echo "FAIL  $name  ($st)$([ -n "$purpose" ] && printf ' — %s' "$purpose")"
          failures=$((failures+1))
        else
          echo "WARN  $name  ($st)"
          warnings=$((warnings+1))
        fi
        ;;
    esac
  done <<< "$(secret_defs)"

  # Alias consistency checks.
  local a b va vb ok
  ok=true
  while IFS='=' read -r a b; do
    [ -n "$a" ] || continue
    [ -f "$SEC/$a.age" ] && [ -f "$SEC/$b.age" ] || continue
    va=$(value_of "$a"); vb=$(value_of "$b")
    if [ -n "$va" ] && [ -n "$vb" ] && [ "$va" != "$vb" ]; then
      echo "FAIL  alias $a != $b  (must be equal)"
      ok=false
    fi
  done <<< "$(alias_pairs)"
  $ok || failures=$((failures+1))

  if [ "$failures" -gt 0 ]; then
    die "$failures required check(s) failed"
  fi
  [ "$warnings" -gt 0 ] && say "$warnings optional warning(s) — investigate but deploy continues"
  say "all required secrets OK"
}

# ── doctor ────────────────────────────────────────────────────────────
cmd_doctor() {
  local allfail=0
  printf '%-36s %-10s %-20s %s\n' NAME CONSUMERS STATUS PURPOSE
  while IFS=$'\t' read -r name consumers required placeholder purpose; do
    [ -n "$name" ] || continue
    local st
    st=$(status_of "$name" "$required" "$placeholder")
    printf '%-36s %-10s %-20s %s\n' "$name" "$consumers" "$st" "$purpose"
    if [ "$required" = "1" ] && [ "$st" != "ok" ]; then allfail=1; fi
  done <<< "$(secret_defs)"
  echo "-- alias constraints --"
  local a b va vb
  while IFS='=' read -r a b; do
    [ -n "$a" ] || continue
    [ -f "$SEC/$a.age" ] && [ -f "$SEC/$b.age" ] || { echo "  $a==$b  (skipped, file absent)"; continue; }
    va=$(value_of "$a"); vb=$(value_of "$b")
    if [ -n "$va" ] && [ -n "$vb" ] && [ "$va" = "$vb" ]; then
      echo "  $a==$b  OK"
    else
      echo "  $a==$b  MISMATCH"
      allfail=1
    fi
  done <<< "$(alias_pairs)"
  [ "$allfail" = "1" ] && die "doctor found failures" || say "doctor: all good"
}

# ── edit ──────────────────────────────────────────────────────────────
cmd_edit() {
  local name=$1
  [ -n "$name" ] || die "usage: hermes-secrets edit <NAME>"
  local line required consumers placeholder purpose
  line=$(secret_defs | awk -F '\t' -v n="$name" '$1==n {print; exit}')
  [ -n "$line" ] || die "no secret named '$name' in $MANIFEST"
  IFS=$'\t' read -r name consumers required placeholder purpose <<< "$line"

  local file="$SEC/$name.age"
  [ -f "$file" ] || die "age file missing: $file"

  local tmp
  tmp=$(mktemp)
  trap 'rm -f "$tmp"' EXIT
  if ! age -d -i "$IDENTITY" "$file" > "$tmp" 2>/dev/null; then
    die "cannot decrypt $file with $IDENTITY"
  fi

  local editor="${EDITOR:-vi}"
  say "editing $name (consumers: $consumers) — saving re-encrypts to both recipients"
  "$editor" "$tmp"
  [ -s "$tmp" ] || die "refusing to save an empty secret ($name) — decrypted file was blank"

  local newval
  newval=$(cat "$tmp")
  if [ -n "$placeholder" ] && [ "$newval" = "$placeholder" ]; then
    say "NOTE: saved value is the configured placeholder '$placeholder' — deploy gate will fail for $name"
  fi

  local ptmp
  ptmp=$(mktemp)
  printf '%s' "$newval" > "$ptmp"
  if ! age -e \
      -r "$(awk '/^ssh-ed25519/{print $0}' "$OP_PUB")" \
      -r "$(awk '/^ssh-ed25519/{print $0}' "$LX_PUB")" \
      -o "$file" "$ptmp" 2>/dev/null; then
    rm -f "$ptmp"
    die "re-encrypt failed (recipients are $OP_PUB + $LX_PUB)"
  fi
  rm -f "$ptmp"

  say "saved $file"
  cmd_check || true
}

# ── list ──────────────────────────────────────────────────────────────
cmd_list() {
  while IFS=$'\t' read -r name consumers required placeholder purpose; do
    [ -n "$name" ] || continue
    st=$(status_of "$name" "$required" "$placeholder")
    printf '%s\t%s\t%s\n' "$name" "$consumers" "$st"
  done <<< "$(secret_defs)"
}

usage() {
  cat <<'EOF'
usage: hermes-secrets [--repo <flake-repo>] <command> [args]

  check              validate all secrets (deploy gate). exit 1 on required failure
  doctor             like check, with a per-secret status table
  edit <NAME>        decrypt with $EDITOR, re-encrypt, re-validate, show consumers
  list               name<TAB>consumers<TAB>status

identity: --identity KEY  (default: /etc/ssh/ssh_host_ed25519_key, then ~/.ssh/id_ed25519)
env:      HERMES_SECRETS_REPO, HERMES_SECRETS_IDENTITY
EOF
  exit 1
}

cmd="${1:-}"
[ -n "$cmd" ] || usage
shift

# Strip leading --repo so `check|doctor|list` don't consume it twice.
case "$cmd" in
  check) cmd_check "$@" ;;
  doctor) cmd_doctor "$@" ;;
  edit) cmd_edit "$@" ;;
  list) cmd_list "$@" ;;
  *) usage ;;
esac