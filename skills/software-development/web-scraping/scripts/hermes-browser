#!/usr/bin/env bash
# hermes-browser - headed browser box with VNC access via noVNC
# Starts Xvfb + x11vnc + websockify for visible Playwright browser via LAN.
# See: cloudflare-strategies.md (strategy #2)
set -euo pipefail

HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}"
VENV="$HERMES_HOME/hermes-agent/venv"
NOVNC="$HOME/scripts/noVNC"
DISPLAY_NUM="${DISPLAY_NUM:-99}"
VNC_PORT="${VNC_PORT:-5900}"
WEB_PORT="${WEB_PORT:-6080}"
SCREEN_SIZE="${SCREEN_SIZE:-1920x1080x24}"
PIDDIR="$HOME/.hermes-browser"

LAN_IP=$(ip -4 addr show | grep -oP 'inet \K192\.168\.[0-9]+\.[0-9]+' | head -1 || echo "localhost")
mkdir -p "$PIDDIR"

start() {
    [ -f "$PIDDIR/websockify.pid" ] && kill "$(cat "$PIDDIR/websockify.pid")" 2>/dev/null || true
    echo "Starting browser box (display :$DISPLAY_NUM)..."
    Xvfb ":$DISPLAY_NUM" -screen 0 "$SCREEN_SIZE" -ac -nolisten tcp &
    echo $! > "$PIDDIR/xvfb.pid"; sleep 1
    x11vnc -display ":$DISPLAY_NUM" -forever -shared -rfbport "$VNC_PORT" -localhost -nopw -quiet &
    echo $! > "$PIDDIR/x11vnc.pid"; sleep 1
    cd "$NOVNC"
    "$VENV/bin/websockify" --web "$NOVNC" "$WEB_PORT" "localhost:$VNC_PORT" &
    echo $! > "$PIDDIR/websockify.pid"; sleep 2
    echo "Ready! http://$LAN_IP:$WEB_PORT/vnc.html"
}

stop() {
    for s in websockify x11vnc xvfb; do
        local f="$PIDDIR/$s.pid"
        [ -f "$f" ] && { kill "$(cat "$f")" 2>/dev/null || true; rm -f "$f"; }
    done
    pkill -f "Xvfb.*:$DISPLAY_NUM" 2>/dev/null || true
}

status() {
    local r=0
    ss -tlnp 2>/dev/null | grep -q ":6080" && { echo "  ✅ websockify ($WEB_PORT)"; r=1; } || echo "  ❌ websockify"
    ss -tlnp 2>/dev/null | grep -q ":5900" && { echo "  ✅ x11vnc ($VNC_PORT)"; r=1; } || echo "  ❌ x11vnc"
    pgrep -f "Xvfb.*:99" >/dev/null 2>&1 && { echo "  ✅ Xvfb (display :99)"; r=1; } || echo "  ❌ Xvfb"
    return $((1 - r))
}

navigate() {
    local target="${1:-https://www.yachtworld.com/}"
    export DISPLAY=":$DISPLAY_NUM"
    echo "Opening headed Chromium... View at http://$LAN_IP:$WEB_PORT/vnc.html"
    "$VENV/bin/python3" -c "
from playwright.sync_api import sync_playwright
import sys
with sync_playwright() as p:
    b = p.chromium.launch(headless=False, args=['--no-sandbox', '--start-maximized'])
    ctx = b.new_context(viewport={'width':1920,'height':1080}, locale='en-US')
    page = ctx.new_page()
    page.goto(sys.argv[1], wait_until='domcontentloaded', timeout=30000)
    print(f'Loaded: {page.title()}')
    page.wait_for_timeout(300000)
    b.close()
" "$target"
}

url() { echo "http://$LAN_IP:$WEB_PORT/vnc.html"; }

case "${1:-start}" in
    start|stop|restart) "$@";;
    status) status || echo "Not running.";;
    url|navigate|screenshot) "$@";;
    *) echo "Usage: $0 {start|stop|restart|status|url|navigate}";;
esac